# Project and locations
GOOGLE_CLOUD_PROJECT=your-existing-gcp-project-id
LOCATION=us
DEPLOY_REGION=us-central1
TRANSCODE_REGION=us-central1
FIRESTORE_LOCATION=nam5
ARTIFACT_REGISTRY_REPOSITORY=plexus-vertical-cuts
SERVICE_ACCOUNT_NAME=plexus-vertical-cuts
SERVICE_ACCOUNT_EMAIL=plexus-vertical-cuts@your-existing-gcp-project-id.iam.gserviceaccount.com

# Main app and workers
SERVICE_NAME=plexus-vertical-cuts
TRANSCODE_SERVICE_NAME=plexus-vertical-cuts-transcode
VERTICAL_RENDER_SERVICE_NAME=plexus-vertical-cuts-render
TRANSCODE_URL=
VERTICAL_RENDER_URL=
TRANSCODE_USE_GPU=0
CLOUD_RUN_DOMAIN=
DOMAIN=http://localhost:8080

# Google authentication
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/local-service-account.json
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SECRET_KEY=replace-with-a-long-random-value
INITIAL_ALLOWED_EMAILS=user@example.com
OAUTHLIB_INSECURE_TRANSPORT=1

# Storage and Firestore
BUCKET_NAME=your-project-plexus-vertical-cuts
GCS_WATCH_BUCKET=
FIRESTORE_DB_NAME="(default)"
COLLECTION_VIDEOS=vertical_cuts_videos
COLLECTION_USERS=vertical_cuts_users
ALLOWED_EMAILS_COLLECTION=vertical_cuts_allowed_emails
COLLECTION_PROMPTS=vertical_cuts_prompts

# Internal API and AI. setup_gcp.sh copies these values into Secret Manager.
SECURITY_TOKEN=replace-with-a-long-random-token
SECRET_KEY_SECRET=plexus-vertical-cuts-session-key
SECURITY_TOKEN_SECRET=plexus-vertical-cuts-api-token
API_TOKEN_SECRET=plexus-vertical-cuts-api-token
GEMINI_API_KEY=
GEMINI_API_KEY_SECRET=plexus-vertical-cuts-gemini-key
GEMINI_MODEL=gemini-2.5-flash
CHIRP_LOCATION=us
CHIRP_FALLBACK_LOCATION=eu
MAX_VIDEO_DURATION_SECONDS=3600
DAILY_VIDEO_LIMIT=20
DEFAULT_CHAPTER_MIN_SECONDS=15
DEFAULT_CHAPTER_MAX_SECONDS=180

# Pub/Sub importers
GCS_PUBSUB_TOPIC=plexus-vertical-cuts-gcs-imports
S3_PUBSUB_TOPIC=plexus-vertical-cuts-s3-imports
GCS_PROCESS_FUNCTION_NAME=process-gcs-bucket
S3_PROCESS_FUNCTION_NAME=process-s3-bucket
MAIN_API_URL=
GCS_MAIN_BUCKET=your-project-plexus-vertical-cuts

# Optional S3 importer. Leave blank when S3 imports are not deployed.
S3_WATCH_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ACCESS_KEY_ID_SECRET=plexus-vertical-cuts-aws-access-key
AWS_SECRET_ACCESS_KEY_SECRET=plexus-vertical-cuts-aws-secret-key
AWS_SESSION_TOKEN_SECRET=

# Rendering defaults
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
DEFAULT_CAPTION_FONT="DejaVu Sans"
DEFAULT_CAPTION_FONT_SIZE=54
